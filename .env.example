# Copy to .env (gitignored) for local development. No value is ever committed.
# The server reads this file for whatever the environment leaves unset.

# Where the server listens. The defaults suit local development.
HOST=127.0.0.1
PORT=8810
# The SQLite file. Empty means data/lantern.sqlite under the repo root.
LANTERN_DB=

# The page's own origin as the browser sees it. Empty means the Vite dev
# server, http://localhost:5180. For `npm start` (the built page on the
# server's own port) set it to http://127.0.0.1:8810.
PUBLIC_ORIGIN=
# The API prefix and the page's base path as the browser sees them. These are the defaults.
# LANTERN_API_PREFIX=/lantern-api
# LANTERN_BASE=/lantern/

# SECRET. TMDB: free account, Settings > API (non-commercial use; Lantern shows
# the TMDB logo and notice). Paste either the "API Key" or the longer "API Read
# Access Token"; Lantern tells them apart.
TMDB_API_KEY=
# SECRET. OMDb: free key by email, 1,000 requests a day.
OMDB_API_KEY=
